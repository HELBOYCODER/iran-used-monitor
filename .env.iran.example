# Copy selected variables into a PRIVATE .env (Docker Compose) or export them.
# Generate a real token; an empty token makes the API fail closed.
IRAN_MONITOR_TOKEN=
IRAN_MONITOR_HOST=127.0.0.1
IRAN_MONITOR_PORT=8000
# Optional AI; basic keyword/price matching needs no paid API.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
