FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN groupadd --gid 10001 monitor && useradd --uid 10001 --gid monitor --no-create-home monitor && mkdir /app/data && chown monitor:monitor /app/data
COPY --chown=monitor:monitor iran_monitor /app/iran_monitor
COPY --chown=monitor:monitor iran_web /app/iran_web
USER monitor
EXPOSE 8000
CMD ["python", "-m", "iran_monitor"]
